@echo off
chcp 65001 >nul
title 《保洁》短剧调度台- 千万不要关这个窗口
cd /d "E:\LLM\try\minidrama\保洁"

echo ============================================================
echo   《保洁》短剧调度台 正在启动...
echo   这个窗口关掉 = 调度停摆，请不要关
echo ============================================================
echo.

rem ── 1. 先把残留的旧进程清干净，避免抢显存/抢端口 ──
echo [1/3] 清理残留进程...
"C:\Users\86134\.workbuddy\binaries\python\envs\default\Scripts\python.exe" _kill_stale.py
echo.

rem ── 2. 启动网页看板（新窗口，用户能看见）──
echo [2/3] 启动网页看板...
start "看板网页 - 双击本文件可重启" cmd /k ""C:\Users\86134\.workbuddy\binaries\python\envs\default\Scripts\python.exe" -u web_server.py"
timeout /t 3 /nobreak >nul

rem ── 3. 启动调度器（本窗口，日志直接打在这里）──
echo [3/3] 启动调度器（ComfyUI 会另开一个黑窗口显示采样进度）...
echo.
"C:\Users\86134\.workbuddy\binaries\python\envs\default\Scripts\python.exe" -u scheduler.py run

echo.
echo ============================================================
echo   调度器已退出。若是正常跑完，按任意键关闭本窗口。
echo   若要重新开始，直接双击「启动调度台.bat」
echo ============================================================
pause