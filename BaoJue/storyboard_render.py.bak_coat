# ---- 链式段必须显式重锚参考图，否则一段接一段会越接越暗 ----
# 曝光重锚：链式段每段都要显式写一次，否则会一段比一段暗。
# 用户 2026-10-03 反馈「偏黑 / 阴影过重 / 不柔和」后，三档都补上了「软光 + 低阴影密度 + 提黑位」，
# 并且**显式禁止**比参考图更暗、更硬 —— 这是防止链式逐段变暗的关键一句。
_SOFT_REMINDER = (
 "Re-light this segment from scratch as soft, bright beauty lighting: one big wrapping soft source plus visible "
 "front fill, faces evenly lit with LOW shadow density, no hard or heavy shadow on any skin, no black shadow under "
 "the eyes, nose or chin, lifted blacks and open midtones. It must look tender and luminous, never hard, never "
 "moody. "
)
EXPOSURE_ANCHOR = (
 "Exposure, white balance and colour must match the reference images exactly — bright, clean, warm daylight, luminous "
 "skin, open shadows. " + _SOFT_REMINDER +
 "Do NOT inherit the tone, grain, contrast or darkness of any previous clip; continuity is in the "
 "character positions and props only, never in the lighting. Never return a clip darker or more contrasty than the "
 "reference images."
)
EXPOSURE_ANCHOR_DUSK = (
 "Exposure, white balance and colour must match the reference images exactly — dusk, but still bright and clean, "
 "open shadows, luminous skin, the ceiling fluorescents clearly on. " + _SOFT_REMINDER +
 "Do NOT inherit the tone, grain, contrast or "
 "darkness of any previous clip; continuity is in the character positions and props only, never in the lighting. "
 "Never return a clip darker or more contrasty than the reference images."
)
EXPOSURE_ANCHOR_NIGHT = (
 "Exposure and colour must match the reference night images exactly — bright but night-balanced, lit only by real "
 "practicals: the warm amber lights in the car roof lining and the glowing paper lantern at the gate, with the warm "
 "shaft of light in the gap of the door. Every face stays clearly lit. " + _SOFT_REMINDER +
 "Do NOT inherit the tone, grain, contrast or "
 "darkness of any previous clip, and do NOT use any daylight source; continuity is in the character positions and "
 "props only, never in the lighting. Never return a clip darker or more contrasty than the reference images."
)

# ---- 第 2 集：室内夜戏（陆宅会客厅 / 陆崇书房）----
# 与 1-5 的"车灯 + 门楣灯笼"不同，这里的光源是**满屋点亮的台灯、壁灯与吊灯**。
# 夜戏必须写成"亮着的夜"，否则 H3 会做成死黑（用户 2026-10-03 明令不得偏黑）。
STYLE_NIGHT_ROOM = (
    VERTICAL + POSE_LIMITS + SOFT_LIGHT +
    "Premium modern urban short drama, shot on a large-format cinema "
    "camera with warm anamorphic character, shallow depth of field and soft oval bokeh, fine 35mm film grain, a warm "
    "low-contrast film grade with lifted blacks, open midtones and soft highlight roll-off. It is night indoors, but "
    "lit like a bright soft-spoken commercial: the room is lit by its own real practical sources, all of them "
    "switched on and generous — the crystal chandelier, the table lamps and the wall sconces, or the green-shaded "
    "desk lamp and the floor lamp — and each of them behaves as a big soft source wrapped in fill, so there is no "
    "dark side on any face and no black shadow anywhere. The polished wood reflects the light cleanly. "
    "Skin stays luminous and fully lit, blacks stay open, lifted and detailed, and every corner of the room stays "
    "readable. Absolutely NOT underexposed, not dark, not murky, not crushed, not contrasty. "
    "Beautiful photogenic cast with refined features and flawless skin, elegant wardrobe. Camera work stays high-end "
    "cinematic: slow controlled dolly moves, gentle handheld, precise rack focus, natural 24fps motion blur."
)
EXPOSURE_ANCHOR_NIGHT_ROOM = (
 "Exposure and colour must match the reference night images exactly — bright but night-balanced, lit only by the real "
 "practicals that are visible in the room: the crystal chandelier and the table lamps and wall sconces in the hall, or "
 "the lit green-shaded desk lamp and the floor lamp in the study. Every face stays clearly lit and every corner of "
 "the room stays readable. " + _SOFT_REMINDER +
 "Do NOT inherit the tone, grain, contrast or darkness of any previous clip, and do NOT use any daylight source; "
 "continuity is in the character positions and props only, never in the lighting. Never return a clip darker or more "
 "contrasty than the reference images."
)

# ---- 第 3 集：出租屋（3-6）的小夜灯档 ----
# 为什么单独一档：上面 night_room 那段是给"陆宅会客厅/书房"写的，光源里点了水晶吊灯、壁灯、
# 绿罩台灯。出租屋里没有这些——它只有"旧台灯 + 正中圆吸顶灯"两盏，照抄那段会把吊灯和绿罩台灯一起烧进画面。
# （SCENE_LIGHT 本体统一定义在本文件下方的公共区，此处不再重复定义，避免两处口径打架。）
STYLE_NIGHT_ROOM_SMALL = (
    VERTICAL + POSE_LIMITS + SOFT_LIGHT +
    "Premium modern urban short drama, shot on a large-format cinema "
    "camera with warm anamorphic character, shallow depth of field and soft oval bokeh, fine 35mm film grain, a warm "
    "low-contrast film grade with lifted blacks, open midtones and soft highlight roll-off. It is night in a cramped "
    "rented room, but lit like a bright soft-spoken commercial: the room has exactly two practicals and both are "
    "switched on — the old table lamp with its warm shade and the round flush ceiling light above the middle of the "
    "room — and together they behave as big soft sources with generous warm bounce filling the little space. Nothing "
    "else in the room emits light: no chandelier, no wall sconce, no floor lamp and no green shaded lamp anywhere. "
    "Every face stays fully and softly lit, blacks stay open, lifted and detailed, "
    "and the yellowed walls stay readable instead of going black. Absolutely NOT underexposed, not dark, not murky, "
    "not crushed, not contrasty. Beautiful photogenic cast with refined features and flawless skin. Camera work stays "
    "high-end cinematic: slow controlled dolly moves, gentle handheld, precise rack focus, natural 24fps motion blur."
)
EXPOSURE_ANCHOR_NIGHT_ROOM_SMALL = (
 "Exposure and colour must match the reference night images exactly — bright but night-balanced, lit only by the real "
 "practicals visible in this rented room: the old table lamp with its warm shade and the round flush ceiling light, "
 "both switched on, with the lamp's warm pool doing the work on the table top. Do not invent any other lamp or "
 "fixture — this room has exactly these two lights. Every face stays clearly lit. " + _SOFT_REMINDER +
 "Do NOT inherit the tone, grain, contrast or darkness of any previous clip, and do NOT use any daylight source; "
 "continuity is in the character positions and props only, never in the lighting. Never return a clip darker or more "
 "contrasty than the reference images."
)

# ---- 第 4/5 集：通用「夜·实用光全开」档 ----
# 为什么再开一档：night 那段的光源写死成 ep001 车顶灯＋门口灯笼，night_room 那段写死成陆宅的水晶吊灯／壁灯／
# 绿罩台灯。杂物间（4-3）只有一根必须亮着的日光灯管，楼门口（5-4）只有一盏路灯——照抄前两档都会把不存在的
# 光源烧进画面，或者干脆把画面拍黑。这一档只讲一件事：**现场有的实用光源，全都开着。**
STYLE_NIGHT_PRACTICAL = (
    VERTICAL + POSE_LIMITS + SOFT_LIGHT +
    "Premium modern urban short drama, shot on a large-format cinema "
    "camera with warm anamorphic character, shallow depth of field and soft oval bokeh, fine 35mm film grain, a warm "
    "low-contrast film grade with lifted blacks, open midtones and soft highlight roll-off. It is night here, but "
    "shot like a bright soft-spoken commercial: every practical light that exists in this location is switched on and "
    "generous, so the space reads warm and clearly lit — walls, floor, props and faces all fully readable, with open, "
    "detailed shadows and no black areas. Do not add any fixture that is not visible in the reference image, and do "
    "not leave any light in the reference image switched off. Every face stays fully and softly lit, blacks stay "
    "open, lifted and detailed. Absolutely NOT underexposed, not dark, not murky, not crushed, not contrasty. "
    "Beautiful photogenic cast with refined features and flawless skin. Camera work stays high-end cinematic: slow "
    "controlled dolly moves, gentle handheld, precise rack focus, natural 24fps motion blur."
)
EXPOSURE_ANCHOR_NIGHT_PRACTICAL = (
 "Exposure and colour must match the reference night images exactly — bright but night-balanced, lit by the "
 "practicals actually present in this location, all of them switched on and generous. Every face stays clearly lit "
 "and every corner of the space stays readable. " + _SOFT_REMINDER +
 "Do NOT inherit the tone, grain, contrast or darkness of any previous clip, and do NOT use any daylight source; "
 "continuity is in the character positions and props only, never in the lighting. Never return a clip darker or more "
 "contrasty than the reference images."
)

# 场景 → 光照档（第 2 集：2-1/2-2/2-5 室内夜戏，2-3/2-4 日戏；第 3 集：3-6 是出租屋夜戏）
SCENE_LIGHT = {
    "1-5": "night", "1-3": "dusk",
    "2-1": "night_room", "2-2": "night_room", "2-5": "night_room",
    "3-6": "night_room_small",
    # 第 4 集：4-1 清晨日戏、4-2 上午日戏、4-3 杂物间夜、4-4 陆崇书房夜
    "4-3": "night_practical", "4-4": "night_room",
    # 第 5 集：5-1/5-2 上午日戏、5-3 出租屋夜（同 3-6）、5-4 楼门口路灯下夜
    "5-3a": "night_room_small", "5-3b": "night_practical",
}


def light_of(seg, ep=None):
    """场景 → 光照档：1-5 / 2-1 / 2-2 / 2-5 夜戏，1-3 傍晚，其余日戏。段里写了 light 字段则以它为准。"""
    if seg.get("light"):
        return seg["light"]
    key = seg.get("scene", "")
    if ep and ep.startswith("xs"):
        key = X003_SCENE_ALIAS.get(key, key)
    return SCENE_LIGHT.get(key, "day")


# ══════════════════════════════════════════════════════════════════════
# LEAN 精简档（2026-10-04 19:00）—— 段里写 "style_pack": "lean" 时生效
#
# 起因：用户反馈「本地理解能力不如 Seedance、总是很混乱，同样的提示词剧情表现不好」。
# 实测：现行提示词 2071 词（H3 官方建议约 350 词，**超 5.9 倍**），
#       命令词 36 次，真正承载剧情的 4 个 [Shot] 只有约 250 词（12%）。
# H3 是 DiT + 文本编码器，1400 多词纯规则把条件向量推向「规则区」，
# 离「剧情语义区」很远 → 读不懂镜头、人物乱动、指令互相打架。
#
# lean 档的原则：**只说「要什么」，不说「不要什么」**。
# 删掉 POSE_LIMITS / NO_TEXT / CROWD_RULES / CAST LOCK / 完整曝光锚点
# 这些「禁止型」内容 —— 它们是「人物复制」「越接越暗」等事故的补丁，
# 但堆到 1400 词时 H3 已经读不进剧情了。宁可少约束，也要保住剧情可读性。
# ══════════════════════════════════════════════════════════════════════
LEAN_STYLE = (
    "VERTICAL 9:16 portrait framing, one continuous take, no cuts. "
    "Bright modern Chinese office at midday: broad soft daylight pouring through wide "
    "venetian blinds, high-key lighting, luminous pale walls, light reflective floor, "
    "every surface clearly readable, airy and open, gentle soft shadows that stay light "
    "and keep their detail, clean luminous image, high-end commercial cinematography on a "
    "large-format camera, shallow depth of field, refined natural faces, elegant wardrobe. "
    "People stay standing, framed from the knees up, camera at a normal medium distance."
)
LEAN_EXPO = (
    "Exposure: the window is a large bright key light and the whole room is filled with "
    "soft bounced daylight, so the image sits high and open across the whole tonal range. "
    "Skin tones are bright and even, with a clean luminous quality. Shadow areas sit in "
    "the light mid-tones and keep visible texture and colour. The darkest corners of the "
    "frame still read as pale grey with detail, the whites stay white, and the picture "
    "carries an even, transparent, high-key brightness from edge to edge."
)

# ⭐ 2026-10-07 用户拍板：**一律不要工牌**。
#   原话「都是显示乱码…字体很奇怪…总容易弄错，现在都是写的苏小满」。
#   为什么要写成禁令而不是只改参考图：
#     ① 模型有很强的"补全"倾向 —— 即使参考图没画，它也会给制服角色自己加一个；
#     ② 一旦加了，每帧中文都不一样 → 必然穿帮。
#   措辞要点：必须**正面说「不要什么」+ 正面说「替代成什么」**，
#   只说"不要工牌"模型仍可能画一个空的挂绳/夹子。改为「胸前一片空白，
#   什么都没有挂」，并明确点名禁止 lanyard / clip / card holder 这些
#   近形物（它们才是模型最常替换上来的东西）。
LEAN_NO_BADGE = (
    "Every chest is completely bare and unadorned: nothing is pinned, clipped, stapled or "
    "hung on any chest, no name badge, no ID card, no lanyard, no card holder, no clip, "
    "no printed text and no logo anywhere on any clothing. Clothing front panels and apron "
    "bibs are plain unmarked fabric from collar to hem. When a character's chest would "
    "normally carry an ID tag, it stays empty and the character simply holds their "
    "clipboard, folder or hands free instead."
)
LEAN_ANCHOR_DEFAULT = (
    "The layout of the room stays constant all take. "
    "The people named in this beat are the only people in it and the count does not change."
)


def scenes_of(ep):
    """X003 集用改名后的场景描述表；其余集返回原表（一个字节都不动）。"""
    if ep.startswith("xs"):
        return {k: _x003(v[0]) for k, v in SCENES.items()}
    return SCENES


def scene_desc(ep, key):
    return scenes_of(ep)[key]


def ordered_refs(seg):
    """槽位顺序永远 = 人物在前、场景在后（<Picture n> 才能和槽位一一对上，避免悬空编号）"""
    raw = seg["refs"]
    chars = [r for r in raw if r in CHARS]
    scens = [r for r in raw if r in SCENES]
    for r in raw:
        if r not in CHARS and r not in SCENES:
            raise SystemExit("未知参考图逻辑名: %s" % r)
    return chars + scens


def render(ep, seg, idx):
    refs = ordered_refs(seg)
    chars = [r for r in refs if r in CHARS]
    scens = [r for r in refs if r in SCENES]
    if len(refs) > 6:
        raise SystemExit("段 %s 参考图超过 6 张" % seg["id"])

    # <Picture n> 与槽位一一对应
    pic = {}
    for i, r in enumerate(refs, 1):
        pic[r] = i

    sd = []
    for i, r in enumerate(chars, 1):
        name, desc = CHARS[r]
        sd.append("<Subject %d> — %s: %s It is the person shown in <Picture %d>." % (i, name, desc, pic[r]))
    for r in scens:
        # 个别段落的参考图需要改写描述（例如 seg117 白天戏却要用夜间车厢图，
        # 必须显式降级成「只做位置/道具参考、不做打光参考」，否则 H3 会把画面拉暗）
        note = (seg.get("ref_notes") or {}).get(r)
        sd.append("<Picture %d>: %s" % (pic[r], note if note else scene_desc(ep, r)))
    if seg.get("extra_refs"):
        sd.append(seg["extra_refs"])

    ret = []
    for i, r in enumerate(chars, 1):
        ret.append("<Subject %d> (%s): %s" % (i, CHARS[r][0], seg["retention"].get(r, "fully_preserved")))
    for r in scens:
        ret.append("<Picture %d>: %s" % (pic[r], seg["retention"].get(r, "weak_reference")))

    lv = light_of(seg, ep)
    style = {"night": STYLE_NIGHT, "dusk": STYLE_DUSK, "night_room": STYLE_NIGHT_ROOM,
             "night_room_small": STYLE_NIGHT_ROOM_SMALL,
             "night_practical": STYLE_NIGHT_PRACTICAL}.get(lv, STYLE)
    expo = {"night": EXPOSURE_ANCHOR_NIGHT, "dusk": EXPOSURE_ANCHOR_DUSK,
            "night_room": EXPOSURE_ANCHOR_NIGHT_ROOM,
            "night_room_small": EXPOSURE_ANCHOR_NIGHT_ROOM_SMALL,
            "night_practical": EXPOSURE_ANCHOR_NIGHT_PRACTICAL}.get(lv, EXPOSURE_ANCHOR)

    # X003 场次号与旧稿不同 → 查锚点前先做别名映射
    akey = seg["scene"]
    if ep.startswith("xs"):
        akey = X003_SCENE_ALIAS.get(seg["scene"], seg["scene"])
    # 段级 anchor 覆盖（2026-10-04 加）：某一段的空间约束与全场不同
    # （例：xs01_t01 出现「人物复制」事故，必须把「门口聚人」的锚点删掉）。
    # 写成 seg["anchor"] 就不用动全局 ANCHORS → 老集 sha 不变。
    anchor_text = seg.get("anchor") or ANCHORS[akey]
    # 段级 crowd 覆盖：seg["crowd"] 置 False 时不拼 CROWD_RULES。
    # 原因：CROWD_RULES 是给「有背景人群」的场景写的，它明写「最多两张可辨识的背景脸」
    # —— 在只有 2–3 人的室内戏里，这句话等于**暗示 H3 可以再加背景脸**，
    # 实测 xs01_t01 就是这么长出第 4、第 5 个人的（2026-10-04）。
    crowd_text = CROWD_RULES if seg.get("crowd", True) else NO_CROWD

    # ══════════════════════════════════════════════════════════════════
    # 段级 style_pack = "lean"：精简版提示词（2026-10-04 19:00 加）
    # ──────────────────────────────────────────────────────────────────
    # 起因（用户反馈）：「本地的理解能力没有 seedance 好，总是很混乱，
    #   同样的提示词 Seedance 剧情就表现的很好」。
    # 实测根因：现行提示词 **2071 词**（H3 官方建议约 350 词，**超 5.9 倍**），
    #   命令词 never/always/not 出现 **36 次**，而真正承载剧情的 4 个 [Shot]
    #   只有约 250 词（12%）—— 前面 1400 多词全是规则。
    # H3 是 DiT + 文本编码器，超长规则文本把条件向量推向「规则区」，
    # 离「剧情语义区」很远 → 表现为读不懂镜头、人物乱动、指令互相打架。
    # 所以做 lean 档：**只保留画风/光/构图/空间/剧情，删掉全部禁止型规则**。
    # 段级开关 → 老集 sha 一个字节都不变。
    if seg.get("style_pack") == "lean":
        anchor_text = seg.get("lean_anchor") or LEAN_ANCHOR_DEFAULT
        # ⭐ LEAN_NO_BADGE 必须**显式拼进去**：lean 档的设计原则是
        # 「只说不要什么、删掉全部禁止型规则」，所以任何新增规则
        # 若不手动拼进来就会被这一档漏掉（2026-10-07 加这条时踩过）。
        desc = (LEAN_STYLE + "\n" + LEAN_EXPO + "\n" + LEAN_NO_BADGE + "\n"
                + SPEAKERS_EP.get(ep, SPEAKERS) + "\n" + anchor_text + "\n"
                + (seg.get("lean_shots") or seg["shots"]))
    else:
        desc = (style + "\n" + POSE_LIMITS + "\n" + NO_TEXT + "\n"
                + LEAN_NO_BADGE + "\n" + crowd_text + "\n"
                + SPEAKERS_EP.get(ep, SPEAKERS) + "\n" + anchor_text + "\n" + expo
                + "\n" + seg["shots"])

    body = []
    body.append("subject_definitions:\n" + "\n".join(sd))
    body.append("summary:\n[reference generation] " + seg["summary"])
    body.append("retention_analysis:\n" + "\n".join(ret))
    body.append("detailed_description:\n" + desc)
    body.append("overall_soundscape: " + seg["soundscape"])
    body.append("non_diegetic_music: " + seg.get("music", "N/A"))
    return "\n\n".join(body) + "\n"


def _pick_ref_dir():
    """参考图目录：环境变量 MINIDRAMA_REF 选orig / soft（默认 soft = 老行为）。

    2026-10-06：官方原版 H3（20 步 / turbo LoRA 8 步）自带足够采样步数把高光
    roll-off 做平滑，不需要靠参考图压高光 → 用 orig。
    turbo8 蒸馏模型跑 4 步时光影过渡没走完，只能靠软调参考图从输入端压 → soft。
    目录不存在时自动回落 assets，保证任何情况下都不至于 404。
    """
    mode = os.environ.get("MINIDRAMA_REF", "soft").lower()
    if mode == "orig":
        return os.path.join(BASE, "assets")
    soft = os.path.join(BASE, "assets_soft")
    return soft if os.path.isdir(soft) else os.path.join(BASE, "assets")


def asset_file(key):
    """beats 里写的是逻辑名（suxiaoman / corridor_pano），落盘要转成 assets 里的真实文件名"""
    if key in CHARS:
        return "char_%s.png" % key
    if key in SCENES:
        return "sc_%s.png" % key
    raise SystemExit("未知参考图逻辑名: %s" % key)


def _write_atomic(path, text):
    """生成器可能正在并发读 jobNN.json，必须原子落盘，绝不能让它读到半个文件。"""
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def _sha(*parts):
    import hashlib
    h = hashlib.sha1()
    for p in parts:
        h.update(json.dumps(p, ensure_ascii=False, sort_keys=True).encode("utf-8"))
    return h.hexdigest()[:16]


def main():
    ep = sys.argv[1]
    beats_dir = os.path.join(BASE, ep + "_beats")
    segs_dir = os.path.join(BASE, ep + "_segs")
    os.makedirs(segs_dir, exist_ok=True)

    all_segs = []
    for f in sorted(glob.glob(os.path.join(beats_dir, "*.json"))):
        all_segs.extend(json.load(open(f, encoding="utf-8")))

    manifest = []
    for idx, seg in enumerate(all_segs, 1):
        txt = render(ep, seg, idx)
        n = "seg%02d" % idx
        pf = os.path.join(segs_dir, n + "_prompt.txt")
        _write_atomic(pf, txt)
        job = {
            "workflow": None,          # 由 autopilot 按段号填充
            "prompt_file": pf,
            "out_prefix": seg["id"],
            # 参考图目录。**由环境变量 MINIDRAMA_REF 决定**（2026-10-06）：
            #   unset / soft → assets_soft（软调版，为迁就「turbo 模型 4 步硬输出」调的）
            #   orig         → assets（原始设定图）
            # 官方原版模型（20步 / turbo LoRA 8步）自带足够的采样步数把高光 roll-off
            # 做平滑，**不需要靠参考图压高光**，硬调过的软调图反而会二次压暗。
            # 所以官方档必须用 orig。
            "ref_dir": _pick_ref_dir(),
            "refs": [asset_file(r) for r in ordered_refs(seg)],
            "prev_video": None,
        }
        jf = os.path.join(segs_dir, "job%02d.json" % idx)
        _write_atomic(jf, json.dumps(job, ensure_ascii=False, indent=1))
        # 统计本段真实中文台词字数（自检用，防超预算）
        import re as _re
        cn = _re.findall(r"\[Chinese\]\s*([^\[\n]*)", seg["shots"])
        nchar = sum(len(_re.findall(r"[\u4e00-\u9fff]", s)) for s in cn)
        manifest.append({"n": idx, "id": seg["id"], "job": jf, "prompt": pf,
                         "scene": seg.get("scene", ""), "title": seg.get("title", ""),
                         "lines": len(cn), "chars": nchar, "over_budget": nchar > 30,
                         "refs": len(seg["refs"]),
                         "sha": _sha(txt, job["refs"])})
        flag = "  ⚠️超预算" if nchar > 30 else ""
        print("渲染 %s  %s  %s  台词%d字/%d句%s" % (n, seg["id"], seg.get("title", ""), nchar, len(cn), flag))

    _write_atomic(os.path.join(segs_dir, "manifest.json"),
                  json.dumps(manifest, ensure_ascii=False, indent=1))
    print("共 %d 段" % len(all_segs))


if __name__ == "__main__":
    main()
